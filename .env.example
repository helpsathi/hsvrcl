# ==============================================================================
# HELPSATHI ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to .env and populate values before launching local or production builds.

# ------------------------------------------------------------------------------
# 1. Database & ORM Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, AWS RDS, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/helpsathi?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Secrets
# ------------------------------------------------------------------------------
# Secret key for JWT session encryption (Generate using: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-here"
# Super Admin override email address (auto-grants SUPER_ADMIN role upon Google login)
SUPER_ADMIN_EMAIL="admin@helpsathi.com"

# ------------------------------------------------------------------------------
# 3. Application URLs & Ports
# ------------------------------------------------------------------------------
# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Socket.IO Realtime Server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Realtime Server Configuration (Used by apps/realtime)
PORT=4000
FRONTEND_URL="http://localhost:3000,https://helpsathi.com,https://www.helpsathi.com"

# ------------------------------------------------------------------------------
# 4. Google OAuth & Google Meet Calendar Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Refresh token for creating Google Meet consultation links automatically
MEET_GOOGLE_REFRESH_TOKEN="your-google-calendar-refresh-token"

# ------------------------------------------------------------------------------
# 5. Payment & Webhook Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 6. Cloud Storage & CDN (ImageKit.io)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint"
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key"

# ------------------------------------------------------------------------------
# 7. Automated Email & Notification Delivery
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
EMAIL_FROM="HelpSathi Notifications <noreply@helpsathi.com>"

# ------------------------------------------------------------------------------
# 8. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@helpsathi.com"

# ------------------------------------------------------------------------------
# 9. Internal Service Security & Scheduled Cron Jobs
# ------------------------------------------------------------------------------
# Shared secret for authenticating API requests from realtime server & Vercel Cron
INTERNAL_API_SECRET="your-internal-service-secret-key"
CRON_SECRET="your-vercel-cron-secret-key"
